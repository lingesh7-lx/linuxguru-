# M) Index Alignment

# 1. Index alignment in Series
import pandas as pd
area = pd.Series({'Alaska': 1723337, 'Texas': 695662, 'California': 423967}, name='area')
population = pd.Series({'California': 38332521, 'Texas': 26448193, 'New York': 19651127},
                        name='population')
data = population / area
print(data)
data1 = area.index | population.index
print(data1)

# missing value handling
import pandas as pd
A = pd.Series([2, 4, 6], index=[0, 1, 2])
B = pd.Series([1, 3, 5], index=[1, 2, 3])
print(A + B)
print(A.add(B, fill_value=0))

# 2. Index alignment in DataFrame
import pandas as pd
import numpy as np
rng = np.random.RandomState(42)
A = pd.DataFrame(rng.randint(0, 20, (2, 2)), columns=list('AB'))
print(A)
B = pd.DataFrame(rng.randint(0, 10, (3, 3)), columns=list('BAC'))
print(B)
print(A + B)
fill = A.stack().mean()
print(fill)
print(A.add(B, fill_value=fill))


# N) Ufuncs: Operations Between DataFrame and Series
import pandas as pd
import numpy as np
rng = np.random.RandomState(42)
A = rng.randint(10, size=(3, 4))
print(A)
print(A - A[0])
# Broadcasting
df = pd.DataFrame(A, columns=list('QRST'))
print(df - df.iloc[0])
print(df.subtract(df['R'], axis=0))
halfrow = df.iloc[0, ::2]
print(halfrow)
print(df - halfrow)