import numpy as np

# 1. Create Arrays
a = np.array([1, 2, 3])
b = np.array([[4, 5, 6], [7, 8, 9]])

# 2. Create Arrays with Specific Values
zeros = np.zeros((2, 3))
ones = np.ones((2, 3))
arange = np.arange(0, 10, 2)
linspace = np.linspace(0, 1, 5)

# 3. Array Operations
x = np.array([1, 2, 3])
y = np.array([4, 5, 6])

add = x + y
sub = x - y
mul = x * y
div = y / x
power = x ** 2
neg = -x
sqrt = np.sqrt(x)

# 4. Aggregation Functions
data = np.array([[1, 2], [3, 4]])

total_sum = np.sum(data)
mean = np.mean(data)
max_val = np.max(data)
row_sum = np.sum(data, axis=1)
col_max = np.max(data, axis=0)

# 5. Boolean Logic
a = np.array([1, 2, 3, 4, 5])

mask = a > 3
filtered = a[a > 3]

# Logical Operations
b = np.array([1, 2, 6, 4, 9])
condition = (a < b) & (a > 2)

# 6. Broadcasting
a = np.array([[1], [2], [3]])   # shape (3,1)
b = np.array([10, 20, 30])      # shape (3,)
result_broadcast = a * b

# Adding a scalar
arr = np.array([[1, 2], [3, 4]])
result_scalar_add = arr + 10

# Printing Outputs
print("Zeros:\n", zeros)
print("Ones:\n", ones)
print("Arange:", arange)
print("Linspace:", linspace)
print("Addition:", add)
print("Subtraction:", sub)
print("Multiplication:", mul)
print("Division:", div)
print("Power:", power)
print("Negative:", neg)
print("Square Root:", sqrt)
print("Total Sum:", total_sum)
print("Mean:", mean)
print("Max Value:", max_val)
print("Row Sum:", row_sum)
print("Column Max:", col_max)
print("Boolean Mask (a > 3):", mask)
print("Filtered Values (a > 3):", filtered)
print("Condition (a < b) & (a > 2):", condition)
print("Broadcasting Result (a * b):\n", result_broadcast)
print("Scalar Addition Result (arr + 10):\n", result_scalar_add)







