# I) Data Indexing and Selection
# J) Data Selection in Series

# 1. Series as dictionary
import pandas as pd
data = pd.Series([0.25, 0.5, 0.75, 1.0], index=['a', 'b', 'c', 'd'])
print(data)
print(data['b'])
print('a' in data)
print(data.keys())
print(list(data.items()))
data['e'] = 1.25
print(data)

# 2. Series as one-dimensional array
import pandas as pd
data = pd.Series([0.25, 0.5, 0.75, 1.0, 1.25], index=['a', 'b', 'c', 'd', 'e'])
# slicing by explicit index
A = data['a':'c']
print(A)
# masking
B = data[(data > 0.3) & (data < 0.8)]
print(B)
# fancy indexing
C = data[['a', 'e']]
print(C)

# 3. Indexers: loc, iloc
import pandas as pd
data = pd.Series(['a', 'b', 'c'], index=[1, 3, 5])
print(data)
# explicit index when indexing
print(data[1])
# implicit index when slicing
print(data[1:3])
# loc
print(data.loc[1])
print(data.loc[1:3])
# iloc
print(data.iloc[1])
print(data.iloc[1:3])


# K) Data Selection in DataFrame

# 1. DataFrame as dictionary
import pandas as pd
area = pd.Series({'California': 423967, 'Texas': 695662, 'New York': 141297,
                   'Florida': 170312, 'Illinois': 149995})
pop = pd.Series({'California': 38332521, 'Texas': 26448193, 'New York': 19651127,
                  'Florida': 19552860, 'Illinois': 12882135})
data = pd.DataFrame({'area': area, 'pop': pop})
print(data)
print(data['area'])
print(data.area is data['area'])
print(data.pop is data['pop'])
data['density'] = data['pop'] / data['area']
print(data)

# 2. DataFrame as two-dimensional array
import pandas as pd
area = pd.Series({'California': 423967, 'Texas': 695662, 'New York': 141297,
                   'Florida': 170312, 'Illinois': 149995})
pop = pd.Series({'California': 38332521, 'Texas': 26448193, 'New York': 19651127,
                  'Florida': 19552860, 'Illinois': 12882135})
density = pd.Series({'California': 90.413926, 'Texas': 38.018740, 'New York': 139.076746,
                      'Florida': 114.806121, 'Illinois': 85.883763})
data = pd.DataFrame({'area': area, 'pop': pop, 'density': density})
print(data.values)
print(data.T)
print(data.values[0])
print(data.iloc[:3, :2])
print(data.loc[:'Illinois', :'pop'])
print(data.loc[data.density > 100, ['pop', 'density']])

# 3. Additional indexing conventions
print(data['Florida':'Illinois'])
print(data[1:3])
print(data[data.density > 100])


# L) Ufuncs: Index Preservation
