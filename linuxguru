-- Step 5: Create Factorial Function
DELIMITER //

CREATE FUNCTION Factorial(n INT)
RETURNS INT(11)
BEGIN
    DECLARE fact INT DEFAULT 1;

    IF n <= 0 THEN
        RETURN 1;
    END IF;

    factorial_loop: LOOP
        SET fact = fact * n;
        SET n = n - 1;

        IF n < 1 THEN
            LEAVE factorial_loop;
        END IF;
    END LOOP factorial_loop;

    RETURN fact;
END//

DELIMITER ;

-- Step 6: Execute Factorial Function
SELECT Factorial(5);


