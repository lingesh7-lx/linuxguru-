-- EX.NO. 10 - STORED PROCEDURES
-- ============================================

-- Step 1: Create ITEM table
CREATE TABLE item (
    ITEMID INT,
    ACTUALPRICE INT,
    ORDID INT,
    PRODID INT
);

-- Insert data shown in the record
INSERT INTO item VALUES (101, 2500, 500, 201);
INSERT INTO item VALUES (102, 3000, 1600, 202);
INSERT INTO item VALUES (103, 4000, 600, 203);

-- Step 2: Display ITEM table
SELECT * FROM item;

-- Step 3: Create Procedure with IN Parameter
DELIMITER //

CREATE PROCEDURE func_in(IN a INT)
BEGIN
    SELECT actualprice
    FROM item
    WHERE itemid = a;
END//

DELIMITER ;

-- Step 4: Call IN Procedure
CALL func_in(101);

-- Step 5: Create Procedure with OUT Parameter
DELIMITER //

CREATE PROCEDURE func_out(IN price INT, OUT Total_count INT)
BEGIN
    SELECT COUNT(*) INTO Total_count
    FROM item
    WHERE actualprice < price;
END//

DELIMITER ;

-- Step 6: Call OUT Procedure
CALL func_out(4000, @Total_count);

SELECT @Total_count;

-- Step 7: Create Procedure with INOUT Parameter
DELIMITER //

CREATE PROCEDURE func_inout(INOUT count INT, IN inc INT)
BEGIN
    SET count = count + inc;
END//

DELIMITER ;

-- Step 8: Initialize Counter
SET @counter = 1;

-- Step 9: Call INOUT Procedure
CALL func_inout(@counter, 1);
CALL func_inout(@counter, 1);
CALL func_inout(@counter, 5);

-- Step 10: Display Final Counter
SELECT @counter;