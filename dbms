-- Query 1: Employees with basic pay less than average
SELECT * FROM sempls
WHERE bpay < (
    SELECT AVG(bpay)
    FROM sempls
);

-- Query 2: Department number and employee count per department
SELECT dno, COUNT(eno)
FROM sempls
GROUP BY dno;

-- Query 3: Employees with basic pay between 10000 and 20000
SELECT * FROM sempls
WHERE bpay BETWEEN 10000 AND 20000;

-- Query 4: Employees working in projects controlled by department 'cse'
SELECT *
FROM sempls, sdments, spros
WHERE sdments.dno = spros.dno
    AND sdments.dno = sempls.dno
    AND dname = 'cse';

-- Query 5: Employees who worked in more than 4 projects on a single day
SELECT sempls.eno, ename, dno, datework
FROM sempls, sworks
WHERE sempls.eno IN (
    SELECT eno
    FROM (
        SELECT eno, datework
        FROM sworks
        GROUP BY eno, datework
        HAVING COUNT(pno) > 4
    ) AS t
)
AND datework IN (
    SELECT datework FROM (
        SELECT eno, datework
        FROM sworks
        GROUP BY eno, datework
        HAVING COUNT(pno) > 4
    ) AS t2
);




-- Step 1: Create Products Table
CREATE TABLE Products (
    product_id INT PRIMARY KEY,
    product_name VARCHAR(50)
);

-- Step 2: Insert Records
INSERT INTO Products (product_id, product_name)
VALUES
(1, 'Samsung Phone'),
(2, 'Sony TV'),
(3, 'Apple Watch'),
(4, 'Cat Toy'),
(5, 'Cute Doll'),
(6, 'Ace Game'),
(7, 'Laptop123'),
(8, '99_Battery');

SELECT * FROM Products;

-- ===== LIKE Operator =====

-- Example 1: Names starting with S
SELECT * FROM Products
WHERE product_name LIKE 'S%';

-- Example 2: Names containing 'Apple'
SELECT * FROM Products
WHERE product_name LIKE '%Apple%';

-- Example 3: C, any one character, t, then anything
SELECT * FROM Products
WHERE product_name LIKE 'C_t%';

-- Example 4: Starts with A, ends with e
SELECT * FROM Products
WHERE product_name LIKE 'A%e';

-- ===== REGEXP Operator =====

-- Example 1: Contains a digit
SELECT * FROM Products
WHERE product_name REGEXP '[0-9]';

-- Example 2: Contains a lowercase letter
SELECT * FROM Products
WHERE product_name REGEXP '[a-z]';

-- Example 3: Contains one or more 'o'
SELECT * FROM Products
WHERE product_name REGEXP 'o+';

-- Example 4: Starts with S
SELECT * FROM Products
WHERE product_name REGEXP '^S';

-- Example 5: Ends with e
SELECT * FROM Products
WHERE product_name REGEXP 'e$';





