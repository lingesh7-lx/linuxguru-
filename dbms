-- Step 1: Create Table t1
CREATE TABLE t1 (
    id INT PRIMARY KEY,
    pattern VARCHAR(50) NOT NULL
);

-- Step 2: Create Table t2
CREATE TABLE t2 (
    id VARCHAR(50) PRIMARY KEY,
    pattern VARCHAR(50) NOT NULL
);

-- Step 3: Insert into t1
INSERT INTO t1 (id, pattern)
VALUES
(1, 'divot'),
(2, 'brick'),
(3, 'grid');

-- Step 4: Insert into t2
INSERT INTO t2 (id, pattern)
VALUES
('a', 'brick'),
('b', 'grid'),
('c', 'diamond');

-- Step 5: Cross Join
SELECT t1.id, t2.id
FROM t1 CROSS JOIN t2;

-- Step 6: Inner Join
SELECT t1.id, t2.id
FROM t1
INNER JOIN t2
ON t1.pattern = t2.pattern;

-- Step 7: Left Join
SELECT t1.id, t2.id
FROM t1
LEFT JOIN t2
ON t1.pattern = t2.pattern
ORDER BY t1.id;

-- Step 8: Right Join
SELECT t1.id, t2.id
FROM t1
RIGHT JOIN t2
ON t1.pattern = t2.pattern
ORDER BY t2.id;




